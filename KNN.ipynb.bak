     "output_type": "execute_result"
    }
   ],
   "source": [
    "class_counts = df[\"Performance\"].value_counts().reindex(\n",
    "    [\"Low\", \"Medium\", \"High\"]\n",
    ")\n",
    "\n",
    "class_counts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "99dab7e8-8157-4522-a4e0-c60a87df1dae",
   "metadata": {},
   "outputs": [
    {
     "data": {
