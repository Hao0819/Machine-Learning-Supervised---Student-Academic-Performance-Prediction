       "                                                                                         (&#x27;scaler&#x27;,\n",
       "                                                                                          StandardScaler())]),\n",
       "                                                                         [&#x27;Hours_Studied&#x27;,\n",
       "                                                                          &#x27;Attendance&#x27;,\n",
       "                                                                          &#x27;Sleep_Hours&#x27;,\n",
       "                                                                          &#x27;Previous_Scores&#x27;,\n",
       "                                                                          &#x27;Tutoring_Sessions&#x27;,\n",
       "                                                                          &#x27;Physical_Activity&#x27;...\n",
