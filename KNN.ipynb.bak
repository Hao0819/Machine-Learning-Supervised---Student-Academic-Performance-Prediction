      "\u001b[36mFile \u001b[39m\u001b[32m~\\anaconda3\\Lib\\site-packages\\sklearn\\metrics\\_pairwise_distances_reduction\\_dispatcher.py:593\u001b[39m, in \u001b[36mArgKminClassMode.compute\u001b[39m\u001b[34m(cls, X, Y, k, weights, Y_labels, unique_Y_labels, metric, chunk_size, metric_kwargs, strategy)\u001b[39m\n\u001b[32m    582\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mValueError\u001b[39;00m(\n\u001b[32m    583\u001b[39m         \u001b[33m\"\u001b[39m\u001b[33mOnly the \u001b[39m\u001b[33m'\u001b[39m\u001b[33muniform\u001b[39m\u001b[33m'\u001b[39m\u001b[33m or \u001b[39m\u001b[33m'\u001b[39m\u001b[33mdistance\u001b[39m\u001b[33m'\u001b[39m\u001b[33m weights options are supported\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m    584\u001b[39m         \u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33m at this time. Got: \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mweights\u001b[38;5;132;01m=}\u001b[39;00m\u001b[33m.\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m    585\u001b[39m     )\n\u001b[32m    586\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m X.dtype == Y.dtype == np.float64:\n\u001b[32m    587\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m ArgKminClassMode64.compute(\n\u001b[32m    588\u001b[39m         X=X,\n\u001b[32m    589\u001b[39m         Y=Y,\n\u001b[32m    590\u001b[39m         k=k,\n\u001b[32m    591\u001b[39m         weights=weights,\n\u001b[32m    592\u001b[39m         Y_labels=np.array(Y_labels, dtype=np.intp),\n\u001b[32m--> \u001b[39m\u001b[32m593\u001b[39m         unique_Y_labels=\u001b[43mnp\u001b[49m\u001b[43m.\u001b[49m\u001b[43marray\u001b[49m\u001b[43m(\u001b[49m\u001b[43munique_Y_labels\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mdtype\u001b[49m\u001b[43m=\u001b[49m\u001b[43mnp\u001b[49m\u001b[43m.\u001b[49m\u001b[43mintp\u001b[49m\u001b[43m)\u001b[49m,\n\u001b[32m    594\u001b[39m         metric=metric,\n\u001b[32m    595\u001b[39m         chunk_size=chunk_size,\n\u001b[32m    596\u001b[39m         metric_kwargs=metric_kwargs,\n\u001b[32m    597\u001b[39m         strategy=strategy,\n\u001b[32m    598\u001b[39m     )\n\u001b[32m    600\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m X.dtype == Y.dtype == np.float32:\n\u001b[32m    601\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m ArgKminClassMode32.compute(\n\u001b[32m    602\u001b[39m         X=X,\n\u001b[32m    603\u001b[39m         Y=Y,\n\u001b[32m   (...)\u001b[39m\u001b[32m    611\u001b[39m         strategy=strategy,\n\u001b[32m    612\u001b[39m     )\n",
      "\u001b[31mValueError\u001b[39m: invalid literal for int() with base 10: 'High'"
     ]
    }
   ],
   "source": [
    "from sklearn.base import clone\n",
    "from sklearn.model_selection import cross_val_score\n",
    "\n",
    "first_failed_parameters = failed_results.iloc[0][\"params\"]\n",
    "\n",
    "print(\"Testing failed parameters:\")\n",
    "print(first_failed_parameters)\n",
    "\n",
    "debug_model = clone(knn_pipeline)\n",
    "debug_model.set_params(**first_failed_parameters)\n",
    "\n",
    "debug_scores = cross_val_score(\n",
    "    debug_model,\n",
    "    X_train,\n",
    "    y_train,\n",
    "    scoring=\"f1_macro\",\n",
    "    cv=cross_validation,\n",
    "    n_jobs=1,\n",
    "    error_score=\"raise\"\n",
    ")\n",
    "\n",
    "debug_scores"
   ]
  },
