      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df.loc[\n",
    "    df[\"Exam_Score\"].isin([64, 65, 69, 70]),\n",
    "    [\"Exam_Score\", \"Performance\"]\n",
    "].drop_duplicates().sort_values(\"Exam_Score\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "aff9c552-5c6c-47c1-b214-1b07058eb99b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Performance\n",
