    }
   ],
   "source": [
    "class_counts.plot(\n",
    "    kind=\"bar\",\n",
    "    color=[\"red\", \"orange\", \"blue\"]\n",
    ")\n",
    "\n",
    "plt.title(\"Distribution of Student Performance Classes\")\n",
    "plt.xlabel(\"Performance Category\")\n",
    "plt.ylabel(\"Number of Students\")\n",
